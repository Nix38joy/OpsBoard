datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Incident {
  id          String   @id @default(uuid())
  title       String
  description String
  team        String
  severity    String   
  status      String   
  priority    String   
  assignee    String
  createdAt   DateTime @default(now())      
  updatedAt   DateTime @updatedAt          
}

